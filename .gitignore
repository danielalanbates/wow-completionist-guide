# secrets
*.env
CREDENTIALS*

# generated guide data (Warcraft Wiki CC BY-SA and Blizzard client data; regenerate with tools/wiki/gen_*.py and
# tools/gen_completion_guides.py) - never commit. Nothing generated belongs in Data/Imported_*: a file there is a
# leftover that tools/install.sh refuses.
CompletionRoute/Guides/Imported_*.lua
CompletionRoute/Data/Imported_*.lua
# offline measurement only, never part of the build (tools/measure/README.md)
tools/measure/questie
tools/measure/out
tools/__pycache__/
__pycache__/

# Blizzard quest POI tables (regenerate: python3 tools/wiki/db2_fetch.py QuestPOIBlob QuestPOIPoint -- retail)
tools/db2/retail/QuestPOI*.csv
# leftovers of the archived Questie tooling (archive/questie-tooling/): never used by the build
tools/db2/questie_index.tsv
*.app
app/*.app/

# Blizzard client-data exports used by tools/coverage.py + tools/gen_completion_guides.py (regenerate from wago.tools)
tools/db2/*/QuestV2.csv
tools/db2/*/QuestLine*.csv
tools/db2/*/Campaign*.csv
tools/db2/*/Achievement*.csv
tools/db2/*/Criteria*.csv
tools/db2/*/GarrMission.csv
tools/db2/*/QuestInfo.csv
tools/db2/*/QuestSort.csv
tools/db2/*/item_quests.tsv
# local no-route / sample harness output
docs/vplayer_*_noroute.tsv
tools/db2/*/Taxi*.csv

tools/db2/questie_spawns.tsv
tools/db2/retail/quest_steps_dump.tsv

# Warcraft Wiki raw cache (CC BY-SA 4.0 source, regenerate: tools/wiki/fetch_wiki.py)
tools/wiki/cache

# parsed Warcraft Wiki tables (CC BY-SA 4.0 derived, regenerate: tools/wiki/parse_wiki.py)
tools/wiki/wiki.sqlite
tools/wiki/__pycache__/
tools/db2/*/QuestObjective.csv
tools/db2/*/BUILD

# SQL chart: local + Drive only (large, rebuilt by the tools; older rows hold reference coordinates), so never commit it.
docs/verification.sqlite
docs/verification.sql

# baked route orders (tools/optimize_routes.py from tools/cost_matrix.lua; regenerate, built on the generated guides)
CompletionRoute/Data/RouteOrder_*.lua

# profession/gold generator inputs (Blizzard client tables and wiki pages, regenerate: tools/wiki/db2_fetch.py, tools/wiki/wiki_fetch.py)
tools/db2/*/*.csv
tools/db2/*/*.csv.part
tools/db2/*/*.missing

# quest prerequisite index for quest-level skipping (tools/gen_quest_deps.py, built on the generated guides + wiki)
CompletionRoute/Data/QuestDeps_*.lua
# quest index for the quest counts in the routes list (tools/gen_quest_index.lua, built on the generated guides)
CompletionRoute/Data/QuestIndex_*.lua
# tools/check_teleports.py: Blizzard client tables and Warcraft Wiki pages it downloads (regenerate with --fetch / --wiki)
tools/teleports_db2
# release builds (tools/package_release.py --write); never committed
dist
